# ============================================================
# Trading System Environment Configuration
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================

# --- Environment ---
TRADING_ENV=paper                  # paper | testnet | production
PAPER_INITIAL_EQUITY=10000          # starting USDT equity for PaperExchangeClient (paper mode only)
LOG_LEVEL=INFO
DEBUG=false

# --- Binance ---
# Which exchange adapter to construct (see bootstrap/exchange_factory.py).
# 'bybit' currently covers REST/market-data/order routing only — the
# unattended live user-data WebSocket stream is still Binance-specific.
EXCHANGE_PROVIDER=binance           # binance | bybit

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true               # true in non-production

BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
BYBIT_TESTNET=true                  # true in non-production

# --- Database ---
DATABASE_URL=postgresql+asyncpg://trader:secret@localhost:5432/trading
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
# 'memory' (default) or 'redis' — mirrors events to Redis Streams for
# other processes to consume (see core/events_redis.py).
EVENT_BUS_BACKEND=memory

# --- Risk ---
MAX_PORTFOLIO_RISK_PCT=2.0         # % of capital at risk per trade
MAX_DAILY_LOSS_PCT=5.0             # circuit breaker threshold
MAX_OPEN_POSITIONS=5
MAX_LEVERAGE=10.0

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# --- Monitoring ---
PROMETHEUS_PORT=9090
DASHBOARD_PORT=8080
DASHBOARD_WS_PORT=8081             # real-time WebSocket push feed (ws://host:port/)
ENABLE_DASHBOARD_WS=true

# --- Paths ---
DATA_DIR=./data
LOG_DIR=./logs
BACKUP_DIR=./backups
MODEL_DIR=./models
